<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  neuromcp Claude desktop-app zombie-session cleanup launchd agent (macOS).

  This file is a TEMPLATE. `bin/neuromcp-enable-zombie-cleanup` substitutes
  the {{...}} placeholders with real values for the installing user and
  writes the result to ~/Library/LaunchAgents/com.neuromcp.zombie-cleanup.plist.

  What it does: every {{INTERVAL_SECONDS}} seconds, scans
  ~/Library/Application Support/Claude/claude-code-sessions/ for
  local_*.json metadata files that were created >1h ago but had
  <30s of activity (i.e. user opened a session and closed it without
  typing anything). Moves them to .trash-zombies-<date>/ siblings.
  Old trash dirs are garbage-collected after 7 days.

  See https://github.com/anthropics/claude-code/issues/59134 for the
  upstream fix request. This agent is the local workaround until that
  ships.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.neuromcp.zombie-cleanup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{SCRIPT_PATH}}</string>
    </array>

    <key>StartInterval</key>
    <integer>{{INTERVAL_SECONDS}}</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{PATH}}</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>{{HOME}}</string>

    <key>StandardOutPath</key>
    <string>{{HOME}}/.neuromcp/zombie-cleanup.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/.neuromcp/zombie-cleanup.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
