{
  "name": "neuromcp",
  "version": "0.17.0",
  "mcpName": "io.github.AdelElo13/neuromcp",
  "description": "Semantic memory for AI agents \u2014 local-first MCP server with hybrid search, governance, and consolidation",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdelElo13/neuromcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./config": "./dist/config.js",
    "./types": "./dist/types.js",
    "./tools/store": "./dist/tools/store.js",
    "./tools/search": "./dist/tools/search.js",
    "./tools/recall": "./dist/tools/recall.js",
    "./tools/forget": "./dist/tools/forget.js",
    "./tools/consolidate": "./dist/tools/consolidate.js",
    "./tools/stats": "./dist/tools/stats.js",
    "./tools/admin": "./dist/tools/admin.js",
    "./tools/backfill": "./dist/tools/backfill.js",
    "./tools/graph": "./dist/tools/graph.js",
    "./storage/database": "./dist/storage/database.js",
    "./storage/migrations": "./dist/storage/migrations.js",
    "./storage/schema": "./dist/storage/schema.js",
    "./embeddings/factory": "./dist/embeddings/factory.js",
    "./embeddings/types": "./dist/embeddings/types.js",
    "./governance/namespace": "./dist/governance/namespace.js",
    "./vectors/sqlite-vec": "./dist/vectors/sqlite-vec.js",
    "./observability/logger": "./dist/observability/logger.js",
    "./observability/metrics": "./dist/observability/metrics.js",
    "./cognitive/claims": "./dist/cognitive/claims.js",
    "./cognitive/contradiction": "./dist/cognitive/contradiction.js",
    "./transport/events": "./dist/transport/events.js",
    "./transport/http": "./dist/transport/http.js",
    "./resources": "./dist/resources/index.js",
    "./prompts": "./dist/prompts/index.js"
  },
  "bin": {
    "neuromcp": "bin/neuromcp.mjs",
    "neuromcp-init-wiki": "bin/init-wiki.mjs",
    "neuromcp-enable-consolidation": "bin/enable-consolidation.mjs",
    "neuromcp-index-wiki": "scripts/index-wiki.mjs",
    "neuromcp-backfill-embeddings": "scripts/backfill-embeddings.mjs",
    "neuromcp-query": "bin/query.mjs",
    "neuromcp-embed": "bin/embed.mjs"
  },
  "files": [
    "dist",
    "bin",
    "scripts",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ && tsc --noEmit",
    "eval": "tsx eval/runner.ts",
    "eval:baseline": "tsx eval/runner.ts --update-baseline",
    "postinstall": "node scripts/download-model.mjs || true"
  },
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "semantic-search",
    "vector",
    "sqlite",
    "claude",
    "cursor"
  ],
  "author": "AdelElo13",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "onnxruntime-node": "^1.18.0",
    "sqlite-vec": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.0.0"
  }
}
