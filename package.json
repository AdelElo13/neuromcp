{
  "name": "neuromcp",
  "version": "0.1.0",
  "description": "Semantic memory for AI agents — local-first MCP server with hybrid search, governance, and consolidation",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "neuromcp": "bin/neuromcp.mjs" },
  "files": ["dist", "bin", "scripts", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/download-model.mjs || true"
  },
  "keywords": ["mcp", "memory", "ai", "semantic-search", "vector", "sqlite", "claude", "cursor"],
  "author": "AdelElo13",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "sqlite-vec": "^0.1.0",
    "onnxruntime-node": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
